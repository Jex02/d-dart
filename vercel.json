{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(index\\.html|flutter_bootstrap\\.js|main\\.dart\\.js|flutter_service_worker\\.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
